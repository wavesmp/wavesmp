{
  "name": "waves-client-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Waves web client",
  "repository": {
    "type": "git",
    "url": "git@github.com:wavesmp/wavesmp.git"
  },
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "watch": "vite build --watch --mode development",
    "format": "prettier . --write --plugin prettier-plugin-organize-imports",
    "lint": "eslint . && tsc -b && prettier . --check --plugin prettier-plugin-organize-imports",
    "test": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/credential-providers": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@aws-sdk/xhr-http-handler": "^3.1169.0",
    "bson-objectid": "^2.0.4",
    "format-duration": "^4.0.0",
    "fuse.js": "^7.5.0",
    "music-metadata": "^13.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "react-transition-group": "^4.4.5",
    "reselect": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/events": "^3.0.3",
    "@types/node": "^26.6.11",
    "@types/node-localstorage": "^1.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@types/sinon": "^22.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "node-localstorage": "^3.0.5",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sinon": "^22.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.2"
  }
}
